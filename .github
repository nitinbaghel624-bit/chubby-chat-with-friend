name: Deploy to GitHub Pages

on:
  push:
    branches:
      - main # जब भी आप main ब्रांच पर कोड पुश करेंगे, ये अपने आप डिप्लॉय हो जाएगा

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Bun सेटअप करने के लिए (क्योंकि आपके पास bun.lock फ़ाइल है)
      - name: Setup Bun
        uses: oven-sh/setup-bun@v1
        with:
          bun-version: latest

      - name: Install dependencies
        run: bun install

      - name: Build project
        run: bun run build

      - name: Setup Pages
        uses: actions/configure-pages@v4

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          # Vite डिफ़ॉल्ट रूप से 'dist' फ़ोल्डर में बिल्ड बनाता है
          path: './dist'

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
